{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "880px",
      "wideSize": "1280px"
    },
    "color": {
      "palette": [
        {
          "slug": "ink",
          "name": "Ink",
          "color": "#292524"
        },
        {
          "slug": "burgundy",
          "name": "Burgundy",
          "color": "#772f3a"
        },
        {
          "slug": "linen",
          "name": "Linen",
          "color": "#f7f1ec"
        },
        {
          "slug": "white",
          "name": "White",
          "color": "#ffffff"
        }
      ]
    },
    "typography": {
      "fluid": false
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "Arial,Helvetica,sans-serif",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "Georgia,'Times New Roman',serif",
          "fontWeight": "500"
        }
      }
    }
  }
}
